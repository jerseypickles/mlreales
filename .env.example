MONGO_URI=mongodb://127.0.0.1:27017/meli-intel
REDIS_URL=redis://127.0.0.1:6379
ZYTE_API_KEY=clave_api_zyte
SCRAPER_LISTADO=zyte
SCRAPER_DETALLE=zyte
# APIFY_TOKEN solo se requiere si se selecciona apify explícitamente.
APIFY_ACTOR_SEARCH=karamelo~mercadolibre-scraper-espanol-castellano
APIFY_ACTOR_DETAILS=ecomscrape~mercadolibre-product-details-scraper
APIFY_SEARCH_MAX_PAGES=4
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
PORT=3000
# ML en observación: captura y entrena al reunir datos suficientes.
# No cambia el prompt ni el orden del radar. ML_ACTIVO=false lo detiene.
ML_ACTIVO=true
# Lunes 10:30, zona America/Santiago.
ML_CRON="30 10 * * 1"
# período (AAAA-MM) de la primera carga en aduana: antes de eso el aviso de la
# DIN queda apagado. Si el embarque se atrasa, se corre acá sin deploy.
PRIMERA_IMPORTACION=2026-10
